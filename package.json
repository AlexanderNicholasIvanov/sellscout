{
  "name": "sellscout",
  "version": "0.1.0",
  "private": true,
  "description": "Describe something you want to sell; sellscout finds the boards and communities where it would sell.",
  "author": "Alexander Ivanov",
  "type": "module",
  "main": "out/desktop/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderNicholasIvanov/sellscout.git"
  },
  "bugs": {
    "url": "https://github.com/AlexanderNicholasIvanov/sellscout/issues"
  },
  "homepage": "https://github.com/AlexanderNicholasIvanov/sellscout#readme",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "npm run build && node server/main.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "e2e": "playwright test",
    "desktop:bundle": "node scripts/build-desktop.mjs",
    "desktop": "npm run build && npm run desktop:bundle && node scripts/run-desktop.mjs",
    "desktop:dist": "npm run build && npm run desktop:bundle && electron-builder --win nsis --publish never",
    "e2e:desktop": "playwright test -c playwright.desktop.config.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
