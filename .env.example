# Port for `npm start` (default 5180).
PORT=

# Where the Settings screen saves keys (default: %APPDATA%\sellscout\settings.json on Windows, ~/.config/sellscout/settings.json on Linux, ~/Library/Application Support/sellscout/settings.json on macOS).
SELLSCOUT_SETTINGS_FILE=

# Reddit app-only ("script" app) credentials. Leave empty to turn Reddit off (look-yourself links only).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Your Reddit username, used only in the User-Agent.
REDDIT_USERNAME=

# eBay Production keyset (App ID, Cert ID) for the Browse API. Leave empty to turn eBay off.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Anthropic API key (console.anthropic.com): Claude picks the boards and the search term. Leave empty for the built-in catalog.
ANTHROPIC_API_KEY=
# Claude model for the planner (default claude-opus-5-5; it must support structured outputs and effort).
SELLSCOUT_CLAUDE_MODEL=

# Fixture mode (canned Reddit data, outbound requests blocked). These two must be set in the
# shell environment, not in .env: in .env they have no effect.
SELLSCOUT_FIXTURES=
# Delay in ms before each fixture response (integer >= 0, default 0).
SELLSCOUT_FIXTURE_DELAY_MS=
