# Port for `npm start` (default 5180).
PORT=

# Reddit app-only ("script" app) credentials. Leave empty to turn Reddit off (look-yourself links only).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Your Reddit username, used only in the User-Agent.
REDDIT_USERNAME=

# Fixture mode (canned Reddit data, outbound requests blocked). These two must be set in the
# shell environment, not in .env: in .env they have no effect.
SELLSCOUT_FIXTURES=
# Delay in ms before each fixture response (integer >= 0, default 0).
SELLSCOUT_FIXTURE_DELAY_MS=
